{
  "name": "Executive Decision Intelligence",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install -r backend/requirements-dev.txt && cp -n .env.example .env || true",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "EDID dashboard", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-python.mypy-type-checker"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["backend/tests"],
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  },
  "remoteUser": "vscode"
}
