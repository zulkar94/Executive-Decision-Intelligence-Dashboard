# Copy to .env and fill in. Never commit the real file.

# development | test | production. Production refuses to start with defaults.
EDID_ENVIRONMENT=development

# openssl rand -base64 48
EDID_SECRET_KEY=change-me

# sqlite+aiosqlite:///./edid.db for local work, postgresql+asyncpg://... otherwise
EDID_DATABASE_URL=sqlite+aiosqlite:///./edid.db

# Comma-separated. Wildcards are rejected in production.
EDID_CORS_ORIGINS=http://localhost:8000
EDID_TRUSTED_HOSTS=localhost,127.0.0.1
EDID_FORCE_HTTPS=false

EDID_RATE_LIMIT_REQUESTS=120
EDID_RATE_LIMIT_WINDOW_SECONDS=60
EDID_AUTH_RATE_LIMIT_REQUESTS=10
EDID_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

EDID_MAX_SIMULATION_RUNS=50000
EDID_MAX_FORECAST_HORIZON=90

# Optional first-run admin. Leave blank to register the first account via the UI.
EDID_BOOTSTRAP_ADMIN_EMAIL=
EDID_BOOTSTRAP_ADMIN_PASSWORD=

# Demo portfolio for local exploration. Ignored in production.
EDID_SEED_DEMO_DATA=false
EDID_DEMO_PASSWORD=

# docker compose only
POSTGRES_PASSWORD=
